# Leave empty unless the backend has server-side OpenF1 live credentials.
OPENF1_USERNAME=
OPENF1_PASSWORD=
OPENF1_TOKEN=

# Third-party portraits are disabled until your deployment has reviewed reuse rights.
OPENF1_IMAGES_ENABLED=false

# Comma-separated URL|Publisher entries. Only public HTTP/HTTPS sources are accepted.
NEWS_FEEDS=https://www.autosport.com/rss/f1/news/|Autosport,https://www.motorsport.com/rss/f1/news/|Motorsport.com,https://www.bbc.co.uk/sport/formula1/rss.xml|BBC Sport
